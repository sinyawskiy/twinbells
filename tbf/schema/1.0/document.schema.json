{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinbells.example/tbf/schema/1.0/document.schema.json",
  "title": "TwinBells Format 1.0 document",
  "description": "A self-contained TwinBells Format document with one root object and its dependencies.",
  "type": "object",
  "required": ["tbf", "documentId", "createdAt", "generator", "root", "objects"],
  "additionalProperties": false,
  "properties": {
    "tbf": {
      "const": "1.0",
      "description": "TBF major.minor version."
    },
    "documentId": {
      "$ref": "#/$defs/uuid",
      "description": "Unique identifier of this exported document."
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "root": {
      "$ref": "#/$defs/ref",
      "description": "The object the user chose to export."
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/metric" },
          { "$ref": "#/$defs/exercise" },
          { "$ref": "#/$defs/program" },
          { "$ref": "#/$defs/journal" }
        ]
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "ref": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["metric", "exercise", "program", "journal"]
        },
        "id": { "$ref": "#/$defs/objectId" }
      }
    },
    "metricRef": {
      "type": "object",
      "required": ["metric", "position", "required"],
      "additionalProperties": false,
      "properties": {
        "metric": { "$ref": "#/$defs/objectId" },
        "position": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" }
      }
    },
    "metric": {
      "type": "object",
      "required": ["type", "id", "name", "kind", "unit", "loadRole", "checksum"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "metric" },
        "id": { "$ref": "#/$defs/objectId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "language": { "$ref": "#/$defs/language" },
        "kind": { "enum": ["number", "duration", "distance"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 30 },
        "loadRole": { "enum": ["none", "weight", "reps"] },
        "archived": { "type": "boolean" },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["type", "id", "name", "restSeconds", "metrics", "checksum"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "exercise" },
        "id": { "$ref": "#/$defs/objectId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 10000 },
        "language": { "$ref": "#/$defs/language" },
        "restSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "archived": { "type": "boolean" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metricRef" }
        },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "rounds", "order"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/objectId" },
        "rounds": { "type": "integer", "minimum": 1, "maximum": 50 },
        "order": { "enum": ["alternating", "sequential"] }
      }
    },
    "programItem": {
      "type": "object",
      "required": ["exercise", "position", "plannedSetCount", "groupPosition"],
      "additionalProperties": false,
      "properties": {
        "exercise": { "$ref": "#/$defs/objectId" },
        "position": { "type": "integer", "minimum": 0 },
        "plannedSetCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "group": { "type": ["string", "null"] },
        "groupPosition": { "type": "integer", "minimum": 0 }
      }
    },
    "program": {
      "type": "object",
      "required": [
        "type",
        "id",
        "name",
        "restBetweenExercisesSeconds",
        "items",
        "checksum"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "program" },
        "id": { "$ref": "#/$defs/objectId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 10000 },
        "language": { "$ref": "#/$defs/language" },
        "archived": { "type": "boolean" },
        "restBetweenExercisesSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/programItem" }
        },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "setValue": {
      "type": "object",
      "required": ["metric", "value", "unitSnapshot", "loadRoleSnapshot"],
      "additionalProperties": false,
      "properties": {
        "metric": { "$ref": "#/$defs/objectId" },
        "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "metricNameSnapshot": { "type": "string", "minLength": 1, "maxLength": 200 },
        "unitSnapshot": { "type": "string", "maxLength": 30 },
        "loadRoleSnapshot": { "enum": ["none", "weight", "reps"] }
      }
    },
    "set": {
      "type": "object",
      "required": ["setNumber", "recordedAt", "values"],
      "additionalProperties": false,
      "properties": {
        "setNumber": { "type": "integer", "minimum": 1 },
        "recordedAt": { "$ref": "#/$defs/timestamp" },
        "notes": { "type": "string", "maxLength": 5000 },
        "completed": { "type": "boolean" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/setValue" }
        }
      }
    },
    "slot": {
      "type": "object",
      "required": ["roundNumber", "positionInRound", "sequencePosition", "status"],
      "additionalProperties": false,
      "properties": {
        "roundNumber": { "type": "integer", "minimum": 1 },
        "positionInRound": { "type": "integer", "minimum": 0 },
        "sequencePosition": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["pending", "completed", "skipped"] },
        "setNumber": { "type": "integer", "minimum": 1 }
      }
    },
    "workoutExercise": {
      "type": "object",
      "required": [
        "exercise",
        "position",
        "groupPosition",
        "groupRounds",
        "groupOrderMode",
        "sets"
      ],
      "additionalProperties": false,
      "properties": {
        "exercise": { "$ref": "#/$defs/objectId" },
        "position": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string", "maxLength": 5000 },
        "plannedSetCount": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "groupKey": { "type": ["string", "null"] },
        "groupPosition": { "type": "integer", "minimum": 0 },
        "groupRounds": { "type": "integer", "minimum": 1, "maximum": 50 },
        "groupOrderMode": { "enum": ["alternating", "sequential"] },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/set" }
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "workout": {
      "type": "object",
      "required": ["id", "title", "startedAt", "status", "exercises"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["in_progress", "completed"] },
        "notes": { "type": "string", "maxLength": 5000 },
        "restBetweenExercisesSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/$defs/workoutExercise" }
        }
      }
    },
    "measureType": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "unit": { "type": "string", "maxLength": 30 },
        "archived": { "type": "boolean" }
      }
    },
    "measureValue": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/uuid" },
        "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" }
      }
    },
    "measureDay": {
      "type": "object",
      "required": ["measuredAt", "values"],
      "additionalProperties": false,
      "properties": {
        "measuredAt": { "$ref": "#/$defs/timestamp" },
        "notes": { "type": "string", "maxLength": 5000 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/measureValue" }
        }
      }
    },
    "measurements": {
      "type": "object",
      "required": ["types", "days"],
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": { "$ref": "#/$defs/measureType" }
        },
        "days": {
          "type": "array",
          "items": { "$ref": "#/$defs/measureDay" }
        }
      }
    },
    "journal": {
      "type": "object",
      "required": ["type", "id", "title", "workouts", "measurements", "checksum"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "journal" },
        "id": { "$ref": "#/$defs/objectId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "personName": { "type": "string", "maxLength": 200 },
        "language": { "$ref": "#/$defs/language" },
        "archived": { "type": "boolean" },
        "workouts": {
          "type": "array",
          "items": { "$ref": "#/$defs/workout" }
        },
        "measurements": { "$ref": "#/$defs/measurements" },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    }
  }
}
